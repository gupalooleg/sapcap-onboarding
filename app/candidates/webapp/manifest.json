{
  "_version": "1.86.0",
  "sap.app": {
    "id": "ah.onboarding.candidates",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.29.0",
      "toolsId": "27f3e807-0469-44b9-81a6-c45933ddea0c"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/onboarding/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "candidates-manage": {
          "semanticObject": "candidates",
          "action": "manage",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.152.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.fe.macros": {},
        "sap.ui.richtexteditor": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "ah.onboarding.candidates.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "CandidatesList",
          "target": "CandidatesList"
        },
        {
          "pattern": "Candidates({key}):?query:",
          "name": "CandidatesObjectPage",
          "target": "CandidatesObjectPage"
        }
      ],
      "targets": {
        "CandidatesList": {
          "type": "Component",
          "id": "CandidatesList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Candidates",
              "variantManagement": "Page",
              "navigation": {
                "Candidates": {
                  "detail": {
                    "route": "CandidatesObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "personalization": {
                      "column": true,
                      "filter": true,
                      "group": true,
                      "sort": true
                    }
                  }
                }
              }
            }
          }
        },
        "CandidatesObjectPage": {
          "type": "Component",
          "id": "CandidatesObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Candidates",
              "content": {
                "body": {
                  "sections": {
                    "Description": {
                      "template": "ah.onboarding.candidates.ext.fragment.Description",
                      "position": {
                        "placement": "After",
                        "anchor": "i18nGeneralInfo"
                      },
                      "title": "{i18n>description}"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "onboarding.service"
  }
}
