@server=http://localhost:4004
@username=alice
@password=


### Employees
# @name Employees_GET
GET {{server}}/odata/v4/employees/Employees
Authorization: Basic {{username}}:{{password}}


### Employees Drafts GET
# @name Employees_Drafts_GET
GET {{server}}/odata/v4/employees/Employees?$filter=(IsActiveEntity eq false)
Authorization: Basic {{username}}:{{password}}


### Employees Draft POST
# @name Employees_Draft_POST
POST {{server}}/odata/v4/employees/Employees
Content-Type: application/json
Authorization: Basic {{username}}:{{password}}

{
  "name": "name-14782615",
  "country": {
    "code": "961"
  },
  "role": {
    "code": "DEVELOPER"
  },
  "beginDate": "2009-03-04",
  "endDate": "2009-03-05",
  "performanceRate": 35
}


### Result from POST request above
@draftID={{Employees_Draft_POST.response.body.$.ID}}


### Employees Draft PATCH
# @name Employees_Draft_Patch
PATCH {{server}}/odata/v4/employees/Employees(ID={{draftID}},IsActiveEntity=false)
Content-Type: application/json
Authorization: Basic {{username}}:{{password}}

{
  "name": "name-14782615",
  "country": {
    "code": "961"
  },
  "role": {
    "code": "DEVELOPER"
  },
  "beginDate": "2008-07-26",
  "endDate": "2009-03-05",
  "performanceRate": 35
}


### Employees Draft Prepare
# @name Employees_Draft_Prepare
POST {{server}}/odata/v4/employees/Employees(ID={{draftID}},IsActiveEntity=false)/EmployeesService.draftPrepare
Content-Type: application/json
Authorization: Basic {{username}}:{{password}}

{}


### Employees Draft Activate
# @name Employees_Draft_Activate
POST {{server}}/odata/v4/employees/Employees(ID={{draftID}},IsActiveEntity=false)/EmployeesService.draftActivate
Content-Type: application/json
Authorization: Basic {{username}}:{{password}}

{}


### Countries
# @name Countries_GET
GET {{server}}/odata/v4/employees/Countries
Authorization: Basic {{username}}:{{password}}


### Roles
# @name Roles_GET
GET {{server}}/odata/v4/employees/Roles
Authorization: Basic {{username}}:{{password}}


### UIConfiguration
# @name UIConfiguration_GET
GET {{server}}/odata/v4/employees/UIConfiguration
Authorization: Basic {{username}}:{{password}}
