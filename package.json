{
  "name": "onboarding",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/attachments": "^4.0.0",
    "@cap-js/hana": "^3",
    "@sap/cds": "^10",
    "@sap/cds-common-content": "^3.2.0",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-candidates": "cds watch --open ah.onboarding.candidates/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-employees": "cds watch --open ah.onboarding.employees/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/candidates",
    "app/employees"
  ],
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked",
        "users": {
          "admin": {
            "roles": [
              "CandidateAdministrator",
              "EmployeeAdministrator"
            ]
          },
          "viewer": {
            "roles": [
              "CandidateViewer",
              "EmployeeViewer"
            ]
          }
        }
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        },
        "malwareScanner": {
          "kind": "malwareScanner-mocked"
        },
        "attachments": {
          "kind": "db",
          "scan": false
        }
      },
      "destinations": true,
      "html5-repo": true,
      "workzone": true
    }
  }
}
